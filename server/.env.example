# 서버 설정 예시. server/.env로 복사해 값을 채운다.
DB_HOST=127.0.0.1
DB_USER=daon
DB_PASSWORD=change-me
DB_DATABASE=daon
# 32자 이상 임의 문자열 (예: openssl rand -hex 32). 없거나 짧으면 서버가 시작되지 않는다
JWT_SECRET=
PORT=5000
# 앱 대신 서버가 보관하는 외부 API 키 (앱 번들에 넣지 않는다)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-nano-2025-04-14
CLOVA_SPEECH_SECRET=
CLOVA_SPEECH_URL=
TOUR_API_KEY=
# 모델 서버(model_server.py)는 같은 서버 안의 주소로 둔다
MODEL_SERVER_URL=http://127.0.0.1:5001/analyze
# 브라우저 클라이언트가 있을 때만 Socket.IO 허용 출처를 쉼표로 지정
SOCKET_CORS_ORIGINS=
# 리버스 프록시 뒤에서 실행할 때 프록시 단계 수 (요청 제한이 실제 클라이언트 IP를 쓰도록)
TRUST_PROXY_HOPS=
